{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DDCAR v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "version", "receipt_id", "issued_at", "expires_at", "nonce", "agent", "authority", "authority_grant", "authority_proof", "requested_action", "requested_action_digest", "evidence", "policy", "prerequisites", "permissions", "assurance", "anomalies", "risk", "decision", "issuer", "lineage", "decision_proof", "execution", "execution_proof"],
  "properties": {
    "spec": {"type": "string", "const": "https://github.com/altrudev/DDC-Action-Receipt/blob/main/spec/DDC-ACTION-RECEIPT-v0.1.md"},
    "version": {"const": "0.1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 256},
    "issued_at": {"$ref": "#/$defs/time"},
    "expires_at": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "agent": {"$ref": "#/$defs/identity"},
    "issuer": {"$ref": "#/$defs/identity"},
    "authority": {"$ref": "#/$defs/authority"},
    "authority_grant": {"oneOf": [{"$ref": "#/$defs/grant"}, {"type": "null"}]},
    "authority_proof": {"$ref": "#/$defs/nullableProof"},
    "requested_action": {"$ref": "#/$defs/action"},
    "requested_action_digest": {"$ref": "#/$defs/digest"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "maxItems": 256},
    "policy": {"$ref": "#/$defs/policy"},
    "prerequisites": {"type": "array", "items": {"$ref": "#/$defs/check"}, "maxItems": 256},
    "permissions": {"type": "array", "items": {"$ref": "#/$defs/check"}, "maxItems": 256},
    "assurance": {"type": "object", "additionalProperties": {"$ref": "#/$defs/check"}},
    "anomalies": {"type": "array", "items": {"$ref": "#/$defs/anomaly"}, "maxItems": 256},
    "risk": {"$ref": "#/$defs/risk"},
    "decision": {"enum": ["ALLOW", "BLOCK", "HUMAN-REVIEW"]},
    "lineage": {"$ref": "#/$defs/lineage"},
    "decision_proof": {"$ref": "#/$defs/nullableProof"},
    "execution": {"oneOf": [{"$ref": "#/$defs/execution"}, {"type": "null"}]},
    "execution_proof": {"$ref": "#/$defs/nullableProof"}
  },
  "$defs": {
    "time": {"type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 512}, "kind": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false},
    "authority": {"type": "object", "required": ["kind", "principal", "basis", "scope"], "properties": {"kind": {"enum": ["human", "organization"]}, "principal": {"type": "string", "minLength": 1}, "basis": {"type": "string", "minLength": 1}, "scope": {"type": "object"}}, "additionalProperties": false},
    "grant": {"type": "object", "required": ["principal", "scope", "expires_at", "nonce", "issued_at", "agent", "action_digest", "delegation_parent"], "properties": {"principal": {"type": "string"}, "scope": {"type": "object"}, "expires_at": {"$ref": "#/$defs/time"}, "issued_at": {"$ref": "#/$defs/time"}, "nonce": {"type": "string", "minLength": 16}, "agent": {"type": "string", "minLength": 1}, "action_digest": {"$ref": "#/$defs/digest"}, "delegation_parent": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}}, "additionalProperties": false},
    "nullableProof": {"oneOf": [{"$ref": "#/$defs/proof"}, {"type": "null"}]},
    "proof": {"type": "object", "required": ["type", "key_id", "signature"], "properties": {"type": {"const": "ddcar-ed25519-v1"}, "key_id": {"type": "string", "minLength": 1}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}}, "additionalProperties": false},
    "tool": {"type": "object", "required": ["kind", "id", "version", "schema_digest"], "properties": {"kind": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "schema_digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": false},
    "action": {"type": "object", "required": ["tool", "operation", "parameters"], "properties": {"tool": {"$ref": "#/$defs/tool"}, "operation": {"type": "string", "minLength": 1}, "parameters": {"type": "object"}}, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["type", "digest", "observed_at", "valid_until"], "properties": {"type": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}, "observed_at": {"$ref": "#/$defs/time"}, "valid_until": {"$ref": "#/$defs/time"}, "source": {"type": "string"}, "predecessor": {"type": "string"}}, "additionalProperties": false},
    "policy": {"type": "object", "required": ["id", "version", "digest"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": false},
    "check": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["PASS", "WARN", "FAIL", "UNRESOLVED", "NOT-APPLICABLE"]}, "evidence_digest": {"$ref": "#/$defs/digest"}, "claim": {"type": "string"}}, "additionalProperties": false},
    "anomaly": {"type": "object", "required": ["code", "severity"], "properties": {"code": {"type": "string"}, "severity": {"enum": ["low", "medium", "high", "critical"]}, "evidence_digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": false},
    "risk": {"type": "object", "required": ["class"], "properties": {"class": {"enum": ["low", "medium", "high", "critical"]}}, "additionalProperties": false},
    "lineage": {"type": "object", "required": ["previous", "delegation_parent"], "properties": {"previous": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}, "maxItems": 64}, "delegation_parent": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}}, "additionalProperties": false},
    "execution": {"type": "object", "required": ["exact_action", "exact_action_digest", "outcome", "executor", "observed_at"], "properties": {"exact_action": {"$ref": "#/$defs/action"}, "exact_action_digest": {"$ref": "#/$defs/digest"}, "outcome": {"type": "object", "required": ["status", "evidence_digest"], "properties": {"status": {"enum": ["SUCCEEDED", "FAILED", "UNKNOWN"]}, "evidence_digest": {"$ref": "#/$defs/digest"}, "reference": {"type": "string"}}, "additionalProperties": false}, "executor": {"$ref": "#/$defs/identity"}, "observed_at": {"$ref": "#/$defs/time"}}, "additionalProperties": false}
  }
}
